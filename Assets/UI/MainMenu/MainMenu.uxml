<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="MainMenuRoot" style="flex-grow: 1; background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="MainPanel" style="flex-grow: 1; justify-content: center; align-items: center; display: flex;">
            <ui:Label text="LUMOS" name="TitleLabel" style="font-size: 72px; -unity-font-style: bold; color: rgb(0, 0, 0); margin-bottom: 40px;"/>
            <ui:Button text="New Game" name="NewGameButton" style="width: 300px; height: 60px; font-size: 28px; margin-bottom: 12px;"/>
            <ui:Button text="Settings" name="SettingsButton" style="display: none; width: 300px; height: 60px; font-size: 28px; margin-bottom: 12px;"/>
            <ui:Button text="Quit" name="QuitButton" style="width: 300px; height: 60px; font-size: 28px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ChapterPanel" style="display: none; flex-grow: 1; padding-top: 40px; padding-right: 60px; padding-bottom: 40px; padding-left: 60px;">
            <ui:VisualElement name="ChapterHeader" style="flex-direction: row; align-items: flex-end; margin-bottom: 24px; display: flex;">
                <ui:Label text="Select Chapter" name="BreadcrumbLabel" style="font-size: 36px; color: rgb(90, 90, 90); margin-bottom: 8px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ChapterBody" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="LeftColumn" style="width: 38%; margin-right: 32px;">
                    <ui:Label text="Chapters" name="ListHeaderLabel" style="font-size: 20px; color: rgb(90, 90, 90); margin-bottom: 8px;"/>
                    <ui:ScrollView name="ListScroll" style="flex-grow: 1;"/>
                    <ui:Button text="Back" name="ListBackButton" style="height: 56px; font-size: 24px; margin-top: 12px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="RightColumn" style="flex-grow: 1; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(200, 200, 200); border-right-color: rgb(200, 200, 200); border-top-color: rgb(200, 200, 200); border-bottom-color: rgb(200, 200, 200); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
                    <ui:Label text="Pick a chapter to see its parts" name="PreviewEmptyLabel" style="flex-grow: 1; -unity-text-align: middle-center; font-size: 22px; color: rgb(140, 140, 140);"/>
                    <ui:VisualElement name="PreviewContent" style="display: none; flex-grow: 1;">
                        <ui:VisualElement name="PreviewScreenshot" style="height: 45%; background-color: rgb(228, 228, 228); justify-content: center; align-items: center; margin-bottom: 14px; -unity-background-scale-mode: scale-and-crop;">
                            <ui:Label text="Scenario screenshot" name="ScreenshotPlaceholderLabel" style="font-size: 20px; color: rgb(120, 120, 120);"/>
                        </ui:VisualElement>
                        <ui:Label text="Subchapter name" name="PreviewNameLabel" style="font-size: 30px; -unity-font-style: bold; color: rgb(0, 0, 0); margin-bottom: 8px;"/>
                        <ui:Label text="Description" name="PreviewDescriptionLabel" style="font-size: 20px; color: rgb(30, 30, 30); white-space: normal; margin-bottom: 14px;"/>
                        <ui:Label text="What you&apos;ll learn" name="LearnHeaderLabel" style="font-size: 20px; color: rgb(90, 90, 90); margin-bottom: 4px;"/>
                        <ui:VisualElement name="LearnList" style="flex-grow: 1;"/>
                        <ui:Button text="Play" name="PlayButton" style="align-self: flex-end; width: 200px; height: 56px; font-size: 26px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
