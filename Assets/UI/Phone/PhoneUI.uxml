<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/PhoneUI.uss?fileID=7433441132597879392&amp;guid=7cd436e2d6af42b44a904f3fb9ea8ccd&amp;type=3#PhoneUI"/>
    <ui:VisualElement name="PhoneOverlay" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; flex-direction: row; justify-content: flex-end; align-items: center; padding-right: 32px; font-size: 26px; -unity-font-style: bold;">
        <ui:VisualElement name="PhoneFrame" style="flex-grow: 0; width: 33%; height: 90%; background-color: rgb(0, 0, 0); border-top-left-radius: 38px; border-top-right-radius: 38px; border-bottom-right-radius: 38px; border-bottom-left-radius: 38px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; flex-shrink: 0;">
            <ui:VisualElement name="PhoneScreen" style="flex-grow: 0; background-color: rgb(255, 255, 255); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; padding-top: 18px; padding-right: 18px; padding-bottom: 18px; padding-left: 18px; width: 100%; height: 100%; justify-content: flex-start;">
                <ui:VisualElement name="Statusbar" style="flex-grow: 0; flex-direction: row; justify-content: space-between;">
                    <ui:Label text="4:20&#10;" name="Time" class="status-label"/>
                    <ui:Label text="67%" name="Battery" class="status-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="ScreenArea" style="flex-grow: 1; width: 100%; min-height: 0;">
                    <ui:VisualElement name="HomeScreen" class="phone-screen" style="display: flex;">
                        <ui:Label text="Home" name="HomeTitle" class="status-label" style="font-size: 32px;"/>
                        <ui:Label text="Apps" name="AppsTitle" style="font-size: 25px; padding-top: 0; padding-right: 0; padding-bottom: 22px; padding-left: 0; -unity-text-align: upper-left; align-content: flex-start; justify-content: flex-start; align-items: stretch; min-height: 35px;"/>
                        <ui:VisualElement name="AppsGrid" style="flex-grow: 1; width: 100%;">
                            <ui:VisualElement name="AppRowTop" class="app-row" style="align-items: flex-start; flex-shrink: 0; flex-grow: 0; margin-bottom: 16px;">
                                <ui:VisualElement name="MessagesTile" class="app-tile">
                                    <ui:VisualElement name="MessagesIconContainer" class="app-button">
                                        <ui:Button text="M" name="MessagesButton" class="app-button"/>
                                        <ui:Label text="Label" name="HomeUnreadBadge" picking-mode="Ignore" style="position: absolute; margin-top: -8px; margin-right: -8px; min-width: 26px; height: 26px; border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px; background-color: rgb(217, 45, 32); color: rgb(255, 255, 255); -unity-text-align: middle-center; display: none;"/>
                                    </ui:VisualElement>
                                    <ui:Label text="Messages" name="MessagesLabel" class="app-label"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="CameraTile" class="app-tile">
                                    <ui:Button text="C" name="CameraButton" class="app-button" style="background-color: rgb(0, 0, 0); color: rgb(255, 255, 255);"/>
                                    <ui:Label text="Camera" name="CameraLabel" class="app-label"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="AppRowBottom" class="app-row" style="margin-bottom: 16px; align-items: flex-start; flex-grow: 0; flex-shrink: 0;">
                                <ui:VisualElement name="ContractsTile" class="app-tile">
                                    <ui:Button text="C" name="ContractsButton" class="app-button" style="background-color: rgb(0, 146, 255);"/>
                                    <ui:Label text="Contracts" name="ContractsLabel" class="app-label"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="BankTile" class="app-tile">
                                    <ui:Button text="B" name="BankButton" class="app-button" style="background-color: rgb(255, 113, 0);"/>
                                    <ui:Label text="Bank" name="BankLabel" class="app-label"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NotesPanel" style="flex-grow: 0; height: 33%; border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; border-bottom-left-radius: 18px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; margin-bottom: 10px; width: 100%; flex-shrink: 0;">
                            <ui:Label text="Notes" name="NotesTitle" style="font-size: 30px;"/>
                            <ui:Label text="- Do the thing" name="TaskLabel" class="task-label"/>
                            <ui:Label text="- Just do it bruh" name="TaskLabel2" class="task-label"/>
                            <ui:Label text="- Set neighbour on fire" name="TaskLabel3" class="task-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="MessagesScreen" class="phone-screen" style="display: none;">
                        <ui:VisualElement name="MessagesHeader" style="flex-grow: 0; flex-direction: row; align-items: center; flex-shrink: 0; height: 56px; margin-bottom: 8px;">
                            <ui:Button text="←" name="MessagesBackButton" parse-escape-sequences="false" emoji-fallback-support="true" style="width: 40px; height: 40px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; font-size: 24px;"/>
                            <ui:Label text="Messages" name="MessagesHeaderTitle" style="font-size: 24px; margin-left: 10px;"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="ContactsList" horizontal-scroller-visibility="Hidden" style="min-height: 0;"/>
                        <ui:ScrollView name="ConversationList" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; display: none;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="CameraScreen" class="phone-screen" style="flex-grow: 1; display: none;">
                        <ui:Button text="←" name="CameraBackButton" parse-escape-sequences="false" emoji-fallback-support="true" style="width: 40px; height: 40px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; font-size: 24px;"/>
                        <ui:Image name="CameraPreview" source="project://database/Assets/RenderTextures/PhoneCamera.renderTexture?fileID=8400000&amp;guid=d53a086ca18a94141b54988ba1f40ff6&amp;type=2#PhoneCamera" style="width: auto; scale: 1 1; flex-grow: 1; flex-direction: column;"/>
                        <ui:Button text="" name="CameraShutterButton" parse-escape-sequences="false" icon-image="project://database/Resources/unity_builtin_extra?fileID=10912&amp;guid=0000000000000000f000000000000000&amp;type=0#Knob" style="background-color: rgba(188, 188, 188, 0); flex-grow: 0; min-width: auto; background-size: 100% 100%;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="HomeIndicator" style="flex-grow: 0; width: 60px; height: 50px; background-color: rgb(0, 0, 0); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; align-self: center; margin-top: 8px; padding-top: 0; margin-bottom: 8px; min-height: 0; flex-shrink: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
