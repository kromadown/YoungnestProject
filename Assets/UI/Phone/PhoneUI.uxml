<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Phone/PhoneUI.uss?fileID=7433441132597879392&amp;guid=7cd436e2d6af42b44a904f3fb9ea8ccd&amp;type=3"/>
    <ui:VisualElement name="PhoneOverlay" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; flex-direction: row; font-size: 26px; -unity-font-style: bold;">
        <ui:VisualElement name="PhoneFrame" style="background-color: rgb(47, 72, 88);">
            <ui:VisualElement name="PhoneScreen" style="background-image: url(&quot;project://database/Assets/ArtAsset/RoomAsset/Small%20Component/Dophine.png?fileID=2800000&amp;guid=be0e29115c8205e47a4db85ebf833d4d&amp;type=3#Dophine&quot;);">
                <ui:VisualElement name="Statusbar" style="flex-grow: 0; flex-direction: row; justify-content: space-between; color: rgb(47, 72, 88);">
                    <ui:Label text="4:20&#10;" name="Time" class="status-label"/>
                    <ui:Label text="67%" name="Battery" class="status-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="ScreenArea" style="flex-grow: 1; width: 100%; min-height: 0;">
                    <ui:VisualElement name="HomeScreen" class="phone-screen" style="display: flex;">
                        <ui:Label text="Home" name="HomeTitle" class="status-label" style="font-size: 32px; color: rgb(47, 72, 88);"/>
                        <ui:Label text="Apps" name="AppsTitle" style="font-size: 25px; padding-top: 0; padding-right: 0; padding-bottom: 22px; padding-left: 0; -unity-text-align: upper-left; align-content: flex-start; justify-content: flex-start; align-items: stretch; min-height: 35px; color: rgb(47, 72, 88);"/>
                        <ui:VisualElement name="AppsGrid" style="width: 100%; color: rgb(47, 72, 88);">
                            <ui:VisualElement name="MessagesTile" class="app-tile">
                                <ui:VisualElement name="MessagesIconContainer" picking-mode="Ignore" class="app-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                                    <ui:Button text="" name="MessagesButton" class="app-button" style="background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/Message_icon_frame.png?fileID=2800000&amp;guid=09653e9a9c091ac4bb81b3c9973b2b7c&amp;type=3#Message_icon_frame&quot;); background-size: contain; width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-items: center; justify-content: center;">
                                        <ui:VisualElement name="MessagesIcon" picking-mode="Ignore" class="app-icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/Message_Icon.png?fileID=2800000&amp;guid=1d6b766543f37794cb66e0b0277a6efd&amp;type=3#Message_Icon&quot;); width: 80%; height: 80%;"/>
                                    </ui:Button>
                                    <ui:Label text="15&#10;" name="HomeUnreadBadge" picking-mode="Ignore" style="position: absolute; margin-top: -8px; margin-right: -8px; min-width: 25px; height: 50px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; background-color: rgb(255, 129, 47); color: rgb(47, 72, 88); -unity-text-align: middle-center; display: flex; font-size: 40px;"/>
                                </ui:VisualElement>
                                <ui:Label text="Messages" name="MessagesLabel" class="app-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="CameraTile" class="app-tile">
                                <ui:Button text="" name="CameraButton" class="app-button" style="background-color: rgb(0, 0, 0); color: rgb(255, 255, 255); background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/camera_icon_frame.png?fileID=2800000&amp;guid=c1fbde05232268d44b9516f39bbe2a22&amp;type=3#camera_icon_frame&quot;); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(47, 72, 88); border-right-color: rgb(47, 72, 88); border-top-color: rgb(47, 72, 88); border-bottom-color: rgb(47, 72, 88);">
                                    <ui:VisualElement name="CameraIcon" picking-mode="Ignore" class="app-icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/Camera_icon.png?fileID=2800000&amp;guid=50a2b136178193c4d9740c72ab6582f8&amp;type=3#Camera_icon&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                                </ui:Button>
                                <ui:Label text="Camera" name="CameraLabel" class="app-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="ContractsTile" class="app-tile">
                                <ui:Button text="" name="ContractsButton" class="app-button" style="background-color: rgba(0, 146, 255, 0); background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/Contract_icon_frame.png?fileID=2800000&amp;guid=a1734d62731ea864b92ba2c43e81e0ec&amp;type=3#Contract_icon_frame&quot;);">
                                    <ui:VisualElement name="ContractsIcon" picking-mode="Ignore" class="app-icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/Contract_icon.png?fileID=2800000&amp;guid=168a998fb131e8343a923e655a0ba3c9&amp;type=3#Contract_icon&quot;);"/>
                                </ui:Button>
                                <ui:Label text="Contracts" name="ContractsLabel" class="app-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="BankTile" class="app-tile">
                                <ui:Button text="" name="BankButton" class="app-button" style="background-color: rgb(255, 113, 0); background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/Bank_icon_frame.png?fileID=2800000&amp;guid=04b8c221ca8de8e40adcf36bbc7ae940&amp;type=3#Bank_icon_frame&quot;);">
                                    <ui:VisualElement name="BankIcon" picking-mode="Ignore" class="app-icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/Bank_icon.png?fileID=2800000&amp;guid=958e3cb003a8bcc45b2e8d45c59d8f27&amp;type=3#Bank_icon&quot;);"/>
                                </ui:Button>
                                <ui:Label text="Bank" name="BankLabel" class="app-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NotesPanel" style="flex-grow: 0; border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; border-bottom-left-radius: 18px; border-left-color: rgb(47, 72, 88); border-right-color: rgb(47, 72, 88); border-top-color: rgb(47, 72, 88); border-bottom-color: rgb(47, 72, 88); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; margin-bottom: 10px; width: 100%; flex-shrink: 0; color: rgb(47, 72, 88); background-color: rgb(182, 208, 228);">
                            <ui:Label text="Notes" name="NotesHeader" style="font-size: 30px;"/>
                            <ui:ScrollView name="NotesList" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="MessagesScreen" class="phone-screen" style="display: none;">
                        <ui:VisualElement name="MessagesHeader" style="flex-grow: 0; flex-direction: row; align-items: center; flex-shrink: 0; height: 56px; margin-bottom: 8px;">
                            <ui:Button text="←" name="MessagesBackButton" parse-escape-sequences="false" emoji-fallback-support="true" style="width: 40px; height: 40px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; font-size: 24px;"/>
                            <ui:Label text="Messages" name="MessagesHeaderTitle" style="font-size: 24px; margin-left: 10px;"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="ContactsList" horizontal-scroller-visibility="Hidden" style="min-height: 0;"/>
                        <ui:ScrollView name="ConversationList" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; display: none;"/>
                        <ui:VisualElement name="ReplyArea" style="display: none;">
                            <ui:Label text="CHOOSE A REPLY" name="ReplyTitle"/>
                            <ui:ScrollView name="ReplyList" horizontal-scroller-visibility="Hidden"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="CameraScreen" class="phone-screen" style="flex-grow: 1; display: none; height: 100%;">
                        <ui:Button text="←" name="CameraBackButton" parse-escape-sequences="false" emoji-fallback-support="true" style="width: 40px; height: 40px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; font-size: 24px;"/>
                        <ui:Image name="CameraPreview" source="project://database/Assets/RenderTextures/PhoneCamera.renderTexture?fileID=8400000&amp;guid=d53a086ca18a94141b54988ba1f40ff6&amp;type=2#PhoneCamera" scale-mode="ScaleAndCrop" style="width: 100%; scale: 1 1; flex-grow: 1; flex-direction: column; aspect-ratio: auto; align-self: center;">
                            <ui:VisualElement name="CameraGrid" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/ArtAsset/RoomAsset/UiArtAsset/CameraGrid_1.png?fileID=21300000&amp;guid=a9ffed5269705fa4788edaeda2d58528&amp;type=3#CameraGrid_1&quot;); position: absolute; top: 0; left: 0; bottom: 0; right: 0;"/>
                        </ui:Image>
                        <ui:Button text="" name="CameraShutterButton" parse-escape-sequences="false" icon-image="project://database/Resources/unity_builtin_extra?fileID=10912&amp;guid=0000000000000000f000000000000000&amp;type=0#Knob" style="background-color: rgba(188, 188, 188, 0); flex-grow: 0; min-width: auto; background-size: 100% 100%; height: 80px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="HomeIndicator" style="flex-grow: 0; width: 100px; height: 60px; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; align-self: center; margin-top: 8px; padding-top: 0; margin-bottom: 8px; min-height: 0; flex-shrink: 0; background-image: url(&quot;project://database/Assets/ArtAsset/PhoneUi/PhoneButton.png?fileID=2800000&amp;guid=36973f7adf26fac4ea7823edb726d081&amp;type=3#PhoneButton&quot;); background-size: contain;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button text="Phone" name="PhoneToggleButton"/>
</ui:UXML>
