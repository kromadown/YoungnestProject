<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Button text="" name="ContactButton" style="width: 100%; flex-direction: row; align-items: center; align-self: center; align-content: auto; justify-content: flex-start; flex-wrap: nowrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgb(241, 243, 247);">
        <ui:VisualElement name="ContactAvatar" style="flex-grow: 0; width: 48px; height: 48px; border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; min-width: 48px; flex-shrink: 0; background-color: rgb(113, 133, 166);">
            <ui:Label text="L" name="AvatarInitial" style="font-size: 24px; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="ContactInfo" style="flex-grow: 1; min-width: 0;">
            <ui:VisualElement name="ContactTopRow" style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="ContactName" name="ContactName" style="width: 100%; -unity-text-align: upper-left; white-space: normal; font-size: 20px; -unity-font-style: bold;"/>
                <ui:Label text="1" name="UnreadCount" view-data-key="" style="white-space: normal; -unity-text-align: middle-center; font-size: 15px; color: rgb(141, 201, 255); min-width: 26px; min-height: auto; height: 26px; border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px;"/>
            </ui:VisualElement>
            <ui:Label text="ContactPreview" name="ContactPreview" style="width: 100%; white-space: nowrap; -unity-text-align: upper-left; font-size: 17px; text-overflow: ellipsis; overflow: hidden;"/>
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
