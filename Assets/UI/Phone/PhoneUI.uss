:root {
}

.app-button {
    width: 110px;
    height: 110px;
    border-radius: 24px;
    font-size: 36px;
    flex-shrink: 0;
}

.app-label {
    font-size: 20px;
    margin-top: 10px;
}

.task-label {
    font-size: 20px;
    margin-bottom: 10px;
}

.app-tile {
    width: 50%;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    margin-bottom: 16px;
}

.status-label {
    font-size: 18px;
}

.phone-screen {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
}

/* PC */

#PhoneOverlay {
    justify-content: flex-end;
    align-items: center;
    padding-right: 32px;
}

#PhoneFrame {
    width: 33%;
    height: 90%;
    background-color: rgb(0, 0, 0);
    border-radius: 38px;
    padding: 8px;
}

#PhoneScreen {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 30px;
}

#HomeScreen {
    padding: 24px 20px;
}

#NotesPanel {
    height: auto;
}

#AppsGrid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* MOBILE */

.mobile-layout #PhoneOverlay {
    justify-content: flex-start;
    align-items: stretch;
    padding-right: 0;
}

.mobile-layout #PhoneFrame {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 0;
}

.mobile-layout #PhoneScreen {
    border-radius: 0;
}

.mobile-layout #Statusbar,
.mobile-layout #HomeIndicator {
    display: none;
}

-mobile-layout #AppsGrid {
    flex-grow: 1;
    align-content: flex-start;
}

.mobile-layout .app-tile {
    margin-bottom: 24px;
}

.mobile-layout .app-button {
    width: 120px;
    height: 120px;
}
