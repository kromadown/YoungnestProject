:root {
}

.app-button {
    width: 110px;
    height: 110px;
    border-radius: 24px;
    font-size: 36px;
    flex-shrink: 0;
}

.app-label {
    font-size: 20px;
    margin-top: 10px;
}

.task-label {
    font-size: 20px;
    margin-bottom: 10px;
}

.app-tile {
    width: 50%;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    margin-bottom: 16px;
}

.status-label {
    font-size: 18px;
}

.phone-screen {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
}

/* PC */

#PhoneOverlay {
    justify-content: flex-end;
    align-items: center;
    padding-right: 32px;
}

#PhoneFrame {
    width: 33%;
    height: 90%;
    background-color: #000000;
    border-radius: 38px;
    padding: 8px;
}

#PhoneScreen {
    width: 100%;
    height: 100%;
    background-color: #FFFCF8;
    border-radius: 30px;
    padding: 18px;
}

#HomeScreen {
    padding: 0;
}

#NotesPanel {
    height: auto;
}

#AppsGrid {
    flex-direction: row;
    flex-wrap: wrap;
}

#PhoneToggleButton {
    display: none;
    position: absolute;
    
    top: 20px;
    right: 20px;
    
    width: 90px;
    height: 50px;
    
    background-color: #B6D0E4;
    color: #2F4858;
    
    border-radius: 12px;
    
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* PC - MESSAGES APP */
#ContactPreview {
    font-size: 18px;
}

#ContactName {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#ContactButton {
    background-color: #B6D0E4;
}

#UnreadCount {
    flex-shrink: 0;
    margin-left: 10px;
    
    background-color: #FF812F;
    color: #2F4858;
    
    min-width: 25px;
    height: 25px;
    border-radius: 15px;
    
    -unity-text-align: middle-center;
}

#MessageText {
    font-size: 18px;
}

#BubbleBackground {
    width: auto;
    max-width: 85%;
    align-self: flex-start;

    background-color: #B6D0E4;
    color: #2F4858;
}

.outgoing-message {
    justify-content: flex-end;
}

.outgoing-message #BubbleBackground {
    background-color: #2F4858;
    color: #B6D0E4;
}

/* REPLY OPTIONS */

#ReplyArea {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: 40%;
    margin-top: 10px;
}

#ReplyTitle {
    font-size: 15px;
    color: #2F4858;
    margin-bottom: 10px;
}

#ReplyList {
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    max-height: 180px;
}

.reply-choice {
    min-height: 50px;
    flex-shrink: 0;
    
    margin-bottom: 5px;
    padding: 10px;
    
    background-color: #B6D0E4;
    color: #2F4858;
    
    border-radius: 10px;
    font-size: 20px;
    
    white-space: normal;
    -unity-text-align: middle-left;
}

/* MOBILE */

.mobile-layout #PhoneOverlay {
    justify-content: flex-start;
    align-items: stretch;
    padding-right: 0;
}

.mobile-layout #PhoneFrame {
    width: 100%;
    height: 100%;
    background-color: #FFFCF8;
    border-radius: 0;
    padding: 0;
}

.mobile-layout #PhoneScreen {
    border-radius: 0;
    padding: 0;
}

.mobile-layout #HomeScreen {
    padding: 24px 20px;
}

.mobile-layout #Statusbar,
.mobile-layout #HomeIndicator {
    display: none;
}

.mobile-layout #AppsGrid {
    flex-grow: 1;
    align-content: flex-start;
}

.mobile-layout #PhoneToggleButton {
    display: flex;
}

.mobile-layout .app-tile {
    margin-bottom: 24px;
}

.mobile-layout .app-button {
    width: 120px;
    height: 120px;
}

/* MOBILE - MESSAGES APP */

.mobile-layout #MessagesScreen {
    padding: 16px;
}

.mobile-layout #ContactsList,
.mobile-layout #ConversationList {
    flex-grow: 1;
    min-height: 0;
}

.mobile-layout #ContactPreview {
    font-size: 20px;
}

.mobile-layout #MessageText {
    font-size: 20px;
}

.mobile-layout #BubbleBackground {
    width: auto;
    max-width: 90%;
    align-self: flex-start;
}

.mobile-layout #ReplyList {
    max-height: 240px;
}

.mobile-layout .reply-choice {
    min-height: 60px;
    font-size: 20px;
}