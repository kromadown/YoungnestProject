:root {
}

.app-button {
    width: 110px;
    height: 110px;
    border-radius: 24px;
    font-size: 36px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    background-size: contain;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(47, 72, 88);
    border-right-color: rgb(47, 72, 88);
    border-top-color: rgb(47, 72, 88);
    border-bottom-color: rgb(47, 72, 88);
}

.app-label {
    font-size: 20px;
    margin-top: 10px;
}

.task-label {
    font-size: 20px;
    margin-bottom: 10px;
}

.app-tile {
    width: 50%;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    margin-bottom: 16px;
}

.status-label {
    font-size: 18px;
}

.phone-screen {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
}

#PhoneOverlay {
    justify-content: flex-end;
    align-items: center;
    padding-right: 32px;
}

#PhoneFrame {
    width: 33%;
    height: 90%;
    background-color: rgb(0, 0, 0);
    border-radius: 38px;
    padding: 8px;
}

#PhoneScreen {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 252, 248);
    border-radius: 30px;
    padding: 18px;
    background-image: url("project://database/Assets/ArtAsset/RoomAsset/Small%20Component/Dophine.png?fileID=2800000&guid=be0e29115c8205e47a4db85ebf833d4d&type=3#Dophine");
    background-size: cover;
}

#HomeScreen {
    padding: 0;
}

#NotesPanel {
    height: auto;
}

#AppsGrid {
    flex-direction: row;
    flex-wrap: wrap;
}

#PhoneToggleButton {
    display: none;
    position: absolute;
    top: 20px;
    right: 20px;
    width: 90px;
    height: 50px;
    background-color: rgb(182, 208, 228);
    color: rgb(47, 72, 88);
    border-radius: 12px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

#ContactPreview {
    font-size: 18px;
}

#ContactName {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#ContactButton {
    background-color: rgb(182, 208, 228);
}

#UnreadCount {
    flex-shrink: 0;
    margin-left: 10px;
    background-color: rgb(255, 129, 47);
    color: rgb(47, 72, 88);
    min-width: 25px;
    height: 25px;
    border-radius: 15px;
    -unity-text-align: middle-center;
}

#MessageText {
    font-size: 18px;
}

#BubbleBackground {
    width: auto;
    max-width: 85%;
    align-self: flex-start;
    background-color: rgb(182, 208, 228);
    color: rgb(47, 72, 88);
}

.outgoing-message {
    justify-content: flex-end;
}

.outgoing-message #BubbleBackground {
    background-color: rgb(47, 72, 88);
    color: rgb(182, 208, 228);
}

#ReplyArea {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: 40%;
    margin-top: 10px;
}

#ReplyTitle {
    font-size: 15px;
    color: rgb(47, 72, 88);
    margin-bottom: 10px;
}

#ReplyList {
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    max-height: 180px;
}

.reply-choice {
    min-height: 50px;
    flex-shrink: 0;
    margin-bottom: 5px;
    padding: 10px;
    background-color: rgb(182, 208, 228);
    color: rgb(47, 72, 88);
    border-radius: 10px;
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.mobile-layout #PhoneOverlay {
    justify-content: flex-start;
    align-items: stretch;
    padding-right: 0;
}

.mobile-layout #PhoneFrame {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 252, 248);
    border-radius: 0;
    padding: 0;
}

.mobile-layout #PhoneScreen {
    border-radius: 0;
    padding: 0;
}

.mobile-layout #HomeScreen {
    padding: 24px 20px;
}

.mobile-layout #Statusbar,
.mobile-layout #HomeIndicator {
    display: none;
}

.mobile-layout #AppsGrid {
    flex-grow: 1;
    align-content: flex-start;
}

.mobile-layout #PhoneToggleButton {
    display: flex;
}

.mobile-layout .app-tile {
    margin-bottom: 24px;
}

.mobile-layout .app-button {
    width: 120px;
    height: 120px;
}

.mobile-layout #MessagesScreen {
    padding: 16px;
}

.mobile-layout #ContactsList,
.mobile-layout #ConversationList {
    flex-grow: 1;
    min-height: 0;
}

.mobile-layout #ContactPreview {
    font-size: 20px;
}

.mobile-layout #MessageText {
    font-size: 20px;
}

.mobile-layout #BubbleBackground {
    width: auto;
    max-width: 90%;
    align-self: flex-start;
}

.mobile-layout #ReplyList {
    max-height: 240px;
}

.mobile-layout .reply-choice {
    min-height: 60px;
    font-size: 20px;
}

.app-icon {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    background-size: contain;
}
